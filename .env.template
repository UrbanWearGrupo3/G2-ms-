# JWT configuration (Debe ser una clave secreta en Base64 de al menos 256 bits)
JWT_SECRET_KEY=tu_clave_secreta_aqui
JWT_EXPIRATION_TIME=86400000

# Security passcode for Admin registration
ADMIN_PASSCODE=tu_codigo_secreto_aqui

# Database connection (Supabase / PostgreSQL)
DB_URL=jdbc:postgresql://db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña_de_supabase

# Supabase Storage Configuration
SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
SUPABASE_BUCKET_NAME=productos

# Mercado Pago configuration
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_de_mercado_pago_aqui
MERCADOPAGO_SUCCESS_URL=https://www.tu-sitio/success
MERCADOPAGO_PENDING_URL=https://www.tu-sitio/pending
MERCADOPAGO_FAILURE_URL=https://www.tu-sitio/failure

