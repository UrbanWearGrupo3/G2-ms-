# JWT configuration (Debe ser una clave secreta en Base64 de al menos 256 bits)
JWT_SECRET_KEY=tu_clave_secreta_aqui
JWT_EXPIRATION_TIME=86400000

# Security passcode for Admin registration
ADMIN_PASSCODE=tu_codigo_secreto_aqui

# Database connection (Supabase / PostgreSQL)
DB_URL=jdbc:postgresql://db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña_de_supabase
