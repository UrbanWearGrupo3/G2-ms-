# JWT configuration (Debe ser una clave secreta en Base64 de al menos 256 bits)
JWT_SECRET_KEY=tu_clave_secreta_aqui
JWT_EXPIRATION_TIME=86400000

# Security passcode for Admin registration
ADMIN_PASSCODE=tu_codigo_secreto_aqui

# Database connection (Supabase / PostgreSQL)
DB_URL=jdbc:postgresql://db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña_de_supabase

# Supabase Storage Configuration
SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
SUPABASE_BUCKET_NAME=productos

# SMTP Mail Configuration (Para envío de notificaciones y correos)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo_emisor@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion_smtp
ADMIN_EMAIL=correo_administrador@ejemplo.com

# Security configuration for internal endpoints
INTERNAL_TOKEN=token_secreto_compartido_para_backups

# AWS S3 Configuration (Usado por el script de backup)
AWS_ACCESS_KEY_ID=tu_aws_access_key_id
AWS_SECRET_ACCESS_KEY=tu_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-2
AWS_ENDPOINT_URL=https://s3.us-east-2.backblazeb2.com
S3_BUCKET_NAME=urbanwear-backups


